{
  "name": "tarvander",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npx @biomejs/biome check --write ./src",
    "format": "npx @biomejs/biome format --write ./src",
    "lint": "npx @biomejs/biome lint --write ./src",
    "deploy": "dotenv -e .env -- npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db": "dotenv -e .env -- npx prisma db pull --schema=./prisma/schema.prisma",
    "generate": "dotenv -e .env -- npx prisma generate --schema=./prisma/schema.prisma",
    "migrate": "dotenv -e .env -- npx prisma migrate dev --schema=./prisma/schema.prisma",
    "push": "dotenv -e .env -- npx prisma db push --schema=./prisma/schema.prisma",
    "studio": "dotenv -e .env -- npx prisma studio --schema=./prisma/schema.prisma",
    "postbuild": "npx prisma migrate deploy --schema=./prisma/schema.prisma && npx prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "next": "15.1.11",
    "prisma": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sweetalert2": "^11.15.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
