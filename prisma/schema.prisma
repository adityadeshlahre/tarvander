generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  password  String
  name      String
  age       Int
  contact   String
  email     String     @unique
  role      Role
  payment   Payment?
  leader    Leader?    @relation("UserToLeader")
  travelers Traveler[]
}

model Leader {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation("UserToLeader", fields: [userId], references: [id])
  places    Place[]
  travelers Traveler[]
  trips     Trip[]
}

model Trip {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leaderId  Int
  placeId   Int
  leader    Leader   @relation(fields: [leaderId], references: [id])
  place     Place    @relation(fields: [placeId], references: [id])
}

model Traveler {
  id       Int    @id @default(autoincrement())
  name     String
  age      Int
  leaderId Int
  userId   Int?
  leader   Leader @relation(fields: [leaderId], references: [id])
  user     User?  @relation(fields: [userId], references: [id])
}

model Place {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  start       String
  end         String
  price       Int
  leaderId    Int
  leader      Leader @relation(fields: [leaderId], references: [id])
  Trip        Trip[]
}

enum Role {
  LEADER
  PASSENGER
}

enum Payment {
  RAZOR_PAY
  PHONE_PE
}
